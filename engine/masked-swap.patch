+
+// ---- peer-to-peer swaps (MASKED) ----
+// A swap is one Bitcoin transaction with two inputs: the seller's RGB output and the buyer's bitcoin. Output 0
+// is the RGB commitment (OP_RETURN), output `seal_vout` pays the buyer's witness seal, the others pay the seller
+// and the buyer's change. The buyer builds nothing: the seller colours the PSBT here, both sign their own input,
+// and the seller's `send_end` broadcasts it and posts the consignment, recorded as a donation.
+impl Wallet {
+    /// The seller's half of a swap on a PSBT built by the caller (see `new_swap_psbt`). Colours it through the
+    /// same path as `send_begin` and returns it unsigned. The RGB input must be one of the PSBT's inputs; any
+    /// asset change goes to another output of this wallet, as with a normal send.
+    pub async fn color_swap(
+        &mut self,
+        online: Online,
+        psbt: String,
+        asset_id: String,
+        amount: u64,
+        recipient_id: String,
+        seal_vout: u32,
+        seal_amount_sat: u64,
+        transport_endpoints: Vec<String>,
+        min_confirmations: u8,
+    ) -> Result<String, Error> {
+        info!(self.logger, "Swap (begin) for {asset_id}...");
+        if amount == 0 {
+            return Err(Error::InvalidAmountZero);
+        }
+        let mut psbt = Psbt::from_str(&psbt)?;
+        // the commitment output must be the first one, and the seal must be the one the buyer asked for
+        let outputs = &psbt.unsigned_tx.output;
+        if outputs.is_empty() || !outputs[0].script_pubkey.is_op_return() || outputs[0].value.to_sat() != 0 {
+            return Err(Error::Internal { details: s!("swap PSBT: output 0 must be an empty OP_RETURN") });
+        }
+        if seal_vout == 0 || seal_vout as usize >= outputs.len() {
+            return Err(Error::Internal { details: s!("swap PSBT: no output at the seal position") });
+        }
+        let seal_script = crate::utils::script_buf_from_recipient_id(recipient_id.clone())?
+            .ok_or(Error::InvalidRecipientData { details: s!("a swap pays a witness (wvout) invoice") })?;
+        let seal_out = &outputs[seal_vout as usize];
+        if seal_out.script_pubkey != seal_script || seal_out.value.to_sat() != seal_amount_sat {
+            return Err(Error::Internal { details: s!("swap PSBT: the seal output does not pay the buyer's invoice") });
+        }
+
+        let (_fee_rate, unspents, input_unspents, mut runtime) = self._get_transfer_begin_data(online, 1)?;
+
+        let asset = self.database.check_asset_exists(asset_id.clone())?;
+        self.check_schema_support(&asset.schema)?;
+        if !matches!(asset.schema, AssetSchema::Nia | AssetSchema::Ifa) {
+            return Err(Error::InvalidAssignment);
+        }
+
+        let chainnet: ChainNet = self.bitcoin_network().into();
+        let beneficiary = XChainNet::<Beneficiary>::from_str(&recipient_id).map_err(|_| Error::InvalidRecipientID)?;
+        if beneficiary.chain_network() != chainnet {
+            return Err(Error::InvalidRecipientNetwork);
+        }
+        self.check_transport_endpoints(&transport_endpoints)?;
+        let mut endpoints: Vec<LocalTransportEndpoint> = vec![];
+        let mut found_valid = false;
+        for endpoint_str in &transport_endpoints {
+            let te = TransportEndpoint::new(endpoint_str.clone())?;
+            let mut lte = LocalTransportEndpoint {
+                transport_type: te.transport_type,
+                endpoint: te.endpoint.clone(),
+                used: false,
+                usable: false,
+            };
+            if crate::utils::check_proxy_async(&te.endpoint).await.is_ok() {
+                lte.usable = true;
+                found_valid = true;
+            }
+            endpoints.push(lte);
+        }
+        if !found_valid {
+            return Err(Error::InvalidTransportEndpoints { details: s!("no valid transport endpoints") });
+        }
+
+        let assignment = Assignment::Fungible(amount);
+        let mut needed = AssignmentsCollection::default();
+        assignment.add_to_assignments(&mut needed);
+        let recipient = LocalRecipient {
+            recipient_id: recipient_id.clone(),
+            local_recipient_data: LocalRecipientData::Witness(LocalWitnessData {
+                amount_sat: seal_amount_sat,
+                blinding: None,
+                vout: seal_vout,
+            }),
+            assignment,
+            transport_endpoints: endpoints,
+        };
+
+        // only this wallet's outputs that the PSBT already spends can carry the asset
+        let psbt_inputs: HashSet<Outpoint> = psbt
+            .unsigned_tx
+            .input
+            .iter()
+            .map(|i| Outpoint::from(i.previous_output))
+            .collect();
+        let swap_unspents: Vec<LocalUnspent> = input_unspents
+            .iter()
+            .filter(|u| psbt_inputs.contains(&u.utxo.outpoint()))
+            .cloned()
+            .collect();
+        if swap_unspents.is_empty() {
+            return Err(Error::Internal { details: s!("swap PSBT: none of its inputs is an RGB output of this wallet") });
+        }
+        let asset_spend = self._select_rgb_inputs(asset_id.clone(), &needed, swap_unspents)?;
+        if asset_spend.txo_map.values().any(|o| !psbt_inputs.contains(o)) {
+            return Err(Error::Internal { details: s!("swap PSBT: the asset is on an output the PSBT does not spend") });
+        }
+        let all_inputs: HashSet<BdkOutPoint> = asset_spend.txo_map.values().map(|o| o.clone().into()).collect();
+        self._restore_missing_bdk_inputs(&all_inputs).await?;
+
+        let contract_id = ContractId::from_str(&asset_id).map_err(|_| Error::AssetNotFound { asset_id: asset_id.clone() })?;
+        let mut transfer_info_map: BTreeMap<String, InfoAssetTransfer> = BTreeMap::new();
+        transfer_info_map.insert(
+            asset_id.clone(),
+            InfoAssetTransfer {
+                asset_info: AssetInfo { contract_id, reject_list_url: asset.reject_list_url },
+                recipients: vec![recipient],
+                asset_spend,
+                change: AssignmentsCollection::default(),
+                original_assignments_needed: needed.clone(),
+                assignments_needed: needed,
+                assignments_spent: HashMap::new(),
+                main_transition: TypeOfTransition::Transfer,
+            },
+        );
+
+        let txid = psbt.clone().extract_tx().map_err(InternalError::from)?.compute_txid().to_string();
+        let mut rejected = HashSet::new();
+        let ok = self
+            ._prepare_rgb_psbt_wasm(
+                &mut psbt,
+                &mut transfer_info_map,
+                &txid,
+                true,
+                unspents,
+                &mut runtime,
+                min_confirmations,
+                None,
+                &mut rejected,
+            )
+            .await?;
+        if !ok {
+            return Err(Error::Internal { details: s!("part of this asset is on the issuer's reject list: it can't be swapped") });
+        }
+        let final_txid = psbt.clone().extract_tx().map_err(InternalError::from)?.compute_txid().to_string();
+        if final_txid != txid {
+            if let Some(artifacts) = self.transfer_artifacts.remove(&txid) {
+                self.transfer_artifacts.insert(final_txid, artifacts);
+            }
+        }
+        info!(self.logger, "Swap (begin) completed");
+        Ok(psbt.to_string())
+    }
+
+    /// The consignment for a transfer begun here (`color_swap` or `send_begin`) and not sent yet. The buyer
+    /// checks it against the transaction before signing.
+    pub fn pending_consignment(&self, txid: String, asset_id: String) -> Result<Vec<u8>, Error> {
+        self.transfer_artifacts
+            .get(&txid)
+            .and_then(|a| a.consignment_bytes.get(&asset_id))
+            .cloned()
+            .ok_or(Error::UnknownTransfer { txid })
+    }
+}
