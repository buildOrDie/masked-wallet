+
+/// An unsigned swap PSBT: the inputs in order, an empty OP_RETURN at output 0 (where the RGB commitment goes),
+/// then `outputs` in order. Version 2, RBF signalled, no lock time.
+pub fn new_swap_psbt(inputs: Vec<SwapInput>, outputs: Vec<SwapOutput>) -> Result<String, Error> {
+    use bdk_wallet::bitcoin::{Amount, Sequence, TxIn, Witness, absolute::LockTime, consensus::deserialize, transaction::Version};
+    if inputs.len() < 2 || outputs.is_empty() {
+        return Err(Error::Internal { details: s!("a swap has at least two inputs and one output") });
+    }
+    let mut tx_in = vec![];
+    for i in &inputs {
+        tx_in.push(TxIn { previous_output: parse_outpoint(&i.outpoint)?, script_sig: ScriptBuf::new(), sequence: Sequence::ENABLE_RBF_NO_LOCKTIME, witness: Witness::new() });
+    }
+    let mut tx_out = vec![TxOut { value: Amount::ZERO, script_pubkey: ScriptBuf::new_op_return([]) }];
+    for o in &outputs {
+        let script = o.script.as_deref().ok_or(Error::Internal { details: s!("every output needs a script") })?;
+        tx_out.push(TxOut { value: Amount::from_sat(o.sats), script_pubkey: script_from_hex(script)? });
+    }
+    let tx = BdkTransaction { version: Version::TWO, lock_time: LockTime::ZERO, input: tx_in, output: tx_out };
+    let mut psbt = Psbt::from_unsigned_tx(tx).map_err(|e| Error::Internal { details: e.to_string() })?;
+    for (k, i) in inputs.iter().enumerate() {
+        psbt.inputs[k].witness_utxo = Some(TxOut { value: Amount::from_sat(i.sats), script_pubkey: script_from_hex(&i.script)? });
+        if let Some(h) = &i.tx {
+            let bytes = <Vec<u8> as bdk_wallet::bitcoin::hex::FromHex>::from_hex(h.trim()).map_err(|_| Error::Internal { details: s!("bad previous transaction hex") })?;
+            let prev: BdkTransaction = deserialize(&bytes).map_err(|_| Error::Internal { details: s!("bad previous transaction") })?;
+            let op = psbt.unsigned_tx.input[k].previous_output;
+            if prev.compute_txid() != op.txid {
+                return Err(Error::Internal { details: s!("previous transaction does not match the input") });
+            }
+            psbt.inputs[k].non_witness_utxo = Some(prev);
+        }
+    }
+    Ok(psbt.to_string())
+}
+
+/// The outpoints a PSBT spends, "txid:vout", in order.
+pub fn psbt_outpoints(psbt: &str) -> Result<Vec<String>, Error> {
+    let psbt = Psbt::from_str(psbt)?;
+    Ok(psbt.unsigned_tx.input.iter().map(|i| i.previous_output.to_string()).collect())
+}
+
+/// The txid of a PSBT's unsigned transaction (the witness id its consignment carries).
+pub fn psbt_txid(psbt: &str) -> Result<String, Error> {
+    let psbt = Psbt::from_str(psbt)?;
+    Ok(psbt.unsigned_tx.compute_txid().to_string())
+}
+
+/// Check a swap PSBT against what was agreed, before signing it: exactly these inputs in this order, output 0 an
+/// OP_RETURN, then exactly these outputs (a `None` script matches any script, the amount must still match), and
+/// a network fee of exactly `fee_sats` (input values from the PSBT; a wrong value makes every signature invalid).
+pub fn verify_swap_psbt(psbt: &str, inputs: Vec<String>, outputs: Vec<SwapOutput>, fee_sats: u64) -> Result<(), Error> {
+    let bad = |m: &str| Error::Internal { details: format!("swap check: {m}") };
+    let psbt = Psbt::from_str(psbt)?;
+    let tx = &psbt.unsigned_tx;
+    if tx.input.len() != inputs.len() {
+        return Err(bad("the number of inputs changed"));
+    }
+    for (k, want) in inputs.iter().enumerate() {
+        if tx.input[k].previous_output != parse_outpoint(want)? {
+            return Err(bad(&format!("input {k} is not the agreed one")));
+        }
+    }
+    if tx.output.len() != outputs.len() + 1 {
+        return Err(bad("the number of outputs changed"));
+    }
+    if !tx.output[0].script_pubkey.is_op_return() || tx.output[0].value.to_sat() != 0 {
+        return Err(bad("output 0 must be the RGB commitment"));
+    }
+    for (k, want) in outputs.iter().enumerate() {
+        let got = &tx.output[k + 1];
+        if got.value.to_sat() != want.sats {
+            return Err(bad(&format!("output {} pays {} sats, agreed {}", k + 1, got.value.to_sat(), want.sats)));
+        }
+        if let Some(h) = &want.script {
+            if got.script_pubkey != script_from_hex(h)? {
+                return Err(bad(&format!("output {} pays another address", k + 1)));
+            }
+        }
+    }
+    let mut ins = 0u64;
+    for (k, i) in psbt.inputs.iter().enumerate() {
+        let v = i.witness_utxo.as_ref().map(|o| o.value.to_sat()).ok_or(bad(&format!("input {k} has no amount")))?;
+        ins = ins.saturating_add(v);
+    }
+    let outs: u64 = tx.output.iter().map(|o| o.value.to_sat()).sum();
+    if ins < outs || ins - outs != fee_sats {
+        return Err(bad(&format!("the network fee is {} sats, agreed {fee_sats}", ins.saturating_sub(outs))));
+    }
+    Ok(())
+}
+
+/// The output script a witness invoice's seal must be paid to, hex.
+pub fn witness_seal_script(invoice: &str) -> Result<String, Error> {
+    let inv = RgbInvoice::from_str(invoice.trim()).map_err(|_| Error::InvalidInvoice { details: s!("not an RGB invoice") })?;
+    let rid = inv.beneficiary.to_string();
+    let script = crate::utils::script_buf_from_recipient_id(rid)?.ok_or(Error::InvalidRecipientData { details: s!("a swap needs a witness (wvout) invoice") })?;
+    Ok(script.to_hex_string())
+}
+
+
+// ---- pre-signed listings: the buyer's side (no wallet needed) ----
+
+/// What a pre-signed listing's template says, after checking the seller's signature.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[cfg_attr(feature = "camel_case", serde(rename_all = "camelCase"))]
+pub struct PresignedInfo {
+    /// the seller's output, "txid:vout"
+    pub seller_outpoint: String,
+    /// sats on it
+    pub seller_sats: u64,
+    /// its script, hex (P2TR)
+    pub seller_script: String,
+    /// output 0: the seller's payout
+    pub payout_script: String,
+    /// sats of the payout (price + `seller_sats`)
+    pub payout_sats: u64,
+    /// output 1: the RGB commitment, hex
+    pub opret_script: String,
+    /// txid of the template transaction (what the consignment names)
+    pub template_txid: String,
+}
+
+const SEAL_VOUT: usize = 2;
+const SEAL_SATS: u64 = 330;
+/// The seller's input, and its payout output (SIGHASH_SINGLE pairs them). Output 0 is the RGB commitment: RGB anchors
+/// to the first OP_RETURN or taproot output, so nothing taproot may come before it.
+const SELLER: usize = 1;
+
+fn bad_listing(what: &str) -> Error {
+    Error::Internal { details: format!("pre-signed listing: {what}") }
+}
+
+/// Check the seller's input (1) of `tx`: a key-path signature with SIGHASH_SINGLE|ANYONECANPAY that is valid for
+/// `prev` (the output it spends). With that sighash the signature covers only that input and output 1, so the same
+/// check holds for the template and for the buyer's final transaction.
+fn check_seller_signature(tx: &BdkTransaction, prev: &TxOut, witness: &bdk_wallet::bitcoin::Witness) -> Result<(), Error> {
+    let index = SELLER;
+    use bdk_wallet::bitcoin::{key::XOnlyPublicKey, secp256k1::{Message, Secp256k1, schnorr}, sighash::{Prevouts, SighashCache, TapSighashType}};
+    if !prev.script_pubkey.is_p2tr() {
+        return Err(bad_listing("the seller's output is not a taproot output"));
+    }
+    if witness.len() != 1 {
+        return Err(bad_listing("the seller's input is not a key-path signature"));
+    }
+    let sig = witness.nth(0).unwrap_or_default();
+    if sig.len() != 65 || sig[64] != TapSighashType::SinglePlusAnyoneCanPay as u8 {
+        return Err(bad_listing("the seller's signature must be SIGHASH_SINGLE|ANYONECANPAY"));
+    }
+    let key = XOnlyPublicKey::from_slice(&prev.script_pubkey.as_bytes()[2..34]).map_err(|_| bad_listing("bad seller key"))?;
+    let hash = SighashCache::new(tx)
+        .taproot_key_spend_signature_hash(index, &Prevouts::One(index, prev), TapSighashType::SinglePlusAnyoneCanPay)
+        .map_err(|e| bad_listing(&e.to_string()))?;
+    let sig = schnorr::Signature::from_slice(&sig[..64]).map_err(|_| bad_listing("bad signature"))?;
+    let msg = Message::from_digest(hash.to_byte_array());
+    Secp256k1::verification_only()
+        .verify_schnorr(&sig, &msg, &key)
+        .map_err(|_| bad_listing("the seller's signature is not valid"))
+}
+
+/// Read and check a pre-signed listing's template PSBT: a placeholder input 0 and the seller's input 1 (signed);
+/// outputs 0 the commitment (OP_RETURN), 1 the payout, 2 the seal; and a valid seller signature.
+pub fn presigned_listing_info(psbt: &str) -> Result<PresignedInfo, Error> {
+    let psbt = Psbt::from_str(psbt)?;
+    let tx = &psbt.unsigned_tx;
+    if tx.input.len() != 2 || psbt.inputs.len() != 2 {
+        return Err(bad_listing("the template must have a placeholder and the seller's input"));
+    }
+    if tx.output.len() != 3 {
+        return Err(bad_listing("the template must have three outputs"));
+    }
+    let o = &tx.output;
+    if !o[0].script_pubkey.is_op_return() || o[0].value.to_sat() != 0 || o[0].script_pubkey.len() != 34 {
+        return Err(bad_listing("output 0 must be the RGB commitment"));
+    }
+    if o[SEAL_VOUT].value.to_sat() != SEAL_SATS {
+        return Err(bad_listing("output 2 must be the 330-sat seal"));
+    }
+    let prev = psbt.inputs[SELLER].witness_utxo.clone().ok_or(bad_listing("the seller's input has no amount"))?;
+    let witness = psbt.inputs[SELLER].final_script_witness.clone().ok_or(bad_listing("the seller's input is not signed"))?;
+    check_seller_signature(tx, &prev, &witness)?;
+    if o[SELLER].value.to_sat() <= prev.value.to_sat() {
+        return Err(bad_listing("the payout must be more than the seller's output"));
+    }
+    Ok(PresignedInfo {
+        seller_outpoint: tx.input[SELLER].previous_output.to_string(),
+        seller_sats: prev.value.to_sat(),
+        seller_script: prev.script_pubkey.to_hex_string(),
+        payout_script: o[SELLER].script_pubkey.to_hex_string(),
+        payout_sats: o[SELLER].value.to_sat(),
+        opret_script: o[0].script_pubkey.to_hex_string(),
+        template_txid: tx.compute_txid().to_string(),
+    })
+}
+
+/// The buyer's PSBT for a pre-signed listing: the buyer's first input in place of the placeholder (input 0), the
+/// seller's signed input 1 and outputs 0-1 unchanged, the seal (output 2) paid to `seal_script`, then the buyer's other
+/// inputs and its change (if any). The buyer signs its inputs.
+pub fn presigned_buy_psbt(template: &str, buyer_inputs: Vec<SwapInput>, seal_script: String, change: Option<SwapOutput>) -> Result<String, Error> {
+    use bdk_wallet::bitcoin::{Amount, Sequence, TxIn, Witness};
+    presigned_listing_info(template)?;
+    if buyer_inputs.is_empty() {
+        return Err(bad_listing("the buyer pays with at least one input"));
+    }
+    let t = Psbt::from_str(template)?;
+    let mut tx = t.unsigned_tx.clone();
+    tx.output[SEAL_VOUT].script_pubkey = script_from_hex(&seal_script)?;
+    let seller_op = tx.input[SELLER].previous_output;
+    let mut ins = vec![];
+    for i in &buyer_inputs {
+        let op = parse_outpoint(&i.outpoint)?;
+        if op == seller_op {
+            return Err(bad_listing("the buyer can't pay with the seller's output"));
+        }
+        ins.push(TxIn { previous_output: op, script_sig: ScriptBuf::new(), sequence: Sequence::ENABLE_RBF_NO_LOCKTIME, witness: Witness::new() });
+    }
+    // order: buyer's first, the seller's, the buyer's others (the seller's index must stay 1)
+    let seller_in = tx.input[SELLER].clone();
+    let mut order: Vec<usize> = vec![0]; // positions in buyer_inputs
+    tx.input = vec![ins[0].clone(), seller_in];
+    for (k, i) in ins.iter().enumerate().skip(1) { tx.input.push(i.clone()); order.push(k); }
+    if let Some(c) = &change {
+        let script = c.script.as_deref().ok_or(bad_listing("the change needs a script"))?;
+        tx.output.push(TxOut { value: Amount::from_sat(c.sats), script_pubkey: script_from_hex(script)? });
+    }
+    let mut psbt = Psbt::from_unsigned_tx(tx).map_err(|e| Error::Internal { details: e.to_string() })?;
+    psbt.inputs[SELLER] = t.inputs[SELLER].clone();
+    let slots: Vec<usize> = std::iter::once(0).chain(2..psbt.inputs.len()).collect();
+    for (slot, k) in slots.into_iter().zip(order) {
+        let i = &buyer_inputs[k];
+        psbt.inputs[slot].witness_utxo = Some(TxOut { value: Amount::from_sat(i.sats), script_pubkey: script_from_hex(&i.script)? });
+        if let Some(h) = &i.tx {
+            let bytes = <Vec<u8> as bdk_wallet::bitcoin::hex::FromHex>::from_hex(h.trim()).map_err(|_| bad_listing("bad previous transaction hex"))?;
+            let prev: BdkTransaction = bdk_wallet::bitcoin::consensus::deserialize(&bytes).map_err(|_| bad_listing("bad previous transaction"))?;
+            if prev.compute_txid() != psbt.unsigned_tx.input[slot].previous_output.txid {
+                return Err(bad_listing("previous transaction does not match the input"));
+            }
+            psbt.inputs[slot].non_witness_utxo = Some(prev);
+        }
+    }
+    let ins: u64 = psbt.inputs.iter().map(|i| i.witness_utxo.as_ref().map(|o| o.value.to_sat()).unwrap_or(0)).sum();
+    let outs: u64 = psbt.unsigned_tx.output.iter().map(|o| o.value.to_sat()).sum();
+    if ins < outs {
+        return Err(bad_listing("the buyer's inputs don't cover the price"));
+    }
+    Ok(psbt.to_string())
+}
+
+/// The buyer's final check before broadcasting: `final_tx` (hex, signed) still has the template's seller input 1,
+/// commitment (output 0) and payout (output 1), the seal at output 2 pays `seal_script`, nothing taproot or OP_RETURN
+/// comes before the commitment, and the seller's signature is valid for it.
+pub fn check_presigned_final(template: &str, final_tx: &str, seal_script: &str) -> Result<String, Error> {
+    let t = Psbt::from_str(template)?;
+    let bytes = <Vec<u8> as bdk_wallet::bitcoin::hex::FromHex>::from_hex(final_tx.trim()).map_err(|_| bad_listing("bad transaction hex"))?;
+    let tx: BdkTransaction = bdk_wallet::bitcoin::consensus::deserialize(&bytes).map_err(|_| bad_listing("bad transaction"))?;
+    let tt = &t.unsigned_tx;
+    if tx.version != tt.version || tx.lock_time != tt.lock_time || tx.input.len() < 2 || tx.output.len() < 3 {
+        return Err(bad_listing("the transaction does not follow the template"));
+    }
+    if tx.input[SELLER].previous_output != tt.input[SELLER].previous_output || tx.input[SELLER].sequence != tt.input[SELLER].sequence {
+        return Err(bad_listing("input 1 must be the seller's output"));
+    }
+    if tx.output[0] != tt.output[0] || tx.output[SELLER] != tt.output[SELLER] {
+        return Err(bad_listing("the commitment or the payout changed"));
+    }
+    if tx.output[SEAL_VOUT].script_pubkey != script_from_hex(seal_script)? || tx.output[SEAL_VOUT].value.to_sat() != SEAL_SATS {
+        return Err(bad_listing("the seal does not pay the buyer"));
+    }
+    if tx.output.iter().filter(|o| o.script_pubkey.is_op_return()).count() != 1 {
+        return Err(bad_listing("only one OP_RETURN"));
+    }
+    let prev = t.inputs[SELLER].witness_utxo.clone().ok_or(bad_listing("the seller's input has no amount"))?;
+    check_seller_signature(&tx, &prev, &tx.input[SELLER].witness)?;
+    Ok(tx.compute_txid().to_string())
+}
+
+/// The signed transaction of a finalized PSBT, hex (every input must be finalized).
+pub fn psbt_extract_hex(psbt: &str) -> Result<String, Error> {
+    let psbt = Psbt::from_str(psbt)?;
+    if psbt.inputs.iter().any(|i| i.final_script_witness.is_none() && i.final_script_sig.is_none()) {
+        return Err(bad_listing("an input is not signed"));
+    }
+    let tx = psbt.extract_tx_unchecked_fee_rate();
+    Ok(bdk_wallet::bitcoin::consensus::encode::serialize_hex(&tx))
+}
+
+/// The listing's consignment with the buyer's final transaction in place of the template: the transition, its
+/// anchor and the commitment are the same, only the witness transaction (and so its id) changes.
+pub fn complete_presigned_consignment(consignment_bytes: &[u8], template_txid: &str, final_tx: &str) -> Result<Vec<u8>, Error> {
+    let bytes = <Vec<u8> as bdk_wallet::bitcoin::hex::FromHex>::from_hex(final_tx.trim()).map_err(|_| bad_listing("bad transaction hex"))?;
+    let tx: BdkTransaction = bdk_wallet::bitcoin::consensus::deserialize(&bytes).map_err(|_| bad_listing("bad transaction"))?;
+    let template = RgbTxid::from_str(template_txid.trim()).map_err(|_| bad_listing("bad template txid"))?;
+    let mut consignment = RgbTransfer::load(consignment_bytes).map_err(|e| bad_listing(&format!("can't read the consignment: {e}")))?;
+    let mut bundles = consignment.bundles.clone().release();
+    let mut found = 0;
+    for wb in bundles.iter_mut() {
+        if wb.witness_id() == template {
+            wb.pub_witness = PubWitness::Tx(tx.clone());
+            found += 1;
+        }
+    }
+    if found == 0 {
+        return Err(bad_listing("the consignment has no transfer for the template"));
+    }
+    consignment.bundles = Confined::try_from(bundles).map_err(|_| bad_listing("too many bundles"))?;
+    let mut out = Vec::new();
+    consignment.save(&mut out).map_err(|e| bad_listing(&e.to_string()))?;
+    Ok(out)
+}
+
+#[cfg(test)]
+mod presigned_tests {
+    use super::*;
+    use bdk_wallet::bitcoin::{Amount, Sequence, TxIn, Witness, absolute::LockTime, transaction::Version};
+    use bdk_wallet::bitcoin::key::{Keypair, TapTweak};
+    use bdk_wallet::bitcoin::secp256k1::{Message, Secp256k1, SecretKey};
+    use bdk_wallet::bitcoin::sighash::{Prevouts, SighashCache, TapSighashType};
+
+    fn p2tr(byte: u8) -> ScriptBuf { script_from_hex(&("5120".to_string() + &format!("{byte:02x}").repeat(32))).unwrap() }
+
+    /// A template like `presign_sale` makes, signed by a test key.
+    fn template(sighash: TapSighashType) -> (String, TxOut) {
+        let secp = Secp256k1::new();
+        let kp = Keypair::from_secret_key(&secp, &SecretKey::from_slice(&[7u8; 32]).unwrap());
+        let (xonly, _) = kp.x_only_public_key();
+        let tweaked = kp.tap_tweak(&secp, None);
+        let seller = ScriptBuf::new_p2tr(&secp, xonly, None);
+        let prev = TxOut { value: Amount::from_sat(1000), script_pubkey: seller };
+        let placeholder = TxOut { value: Amount::ZERO, script_pubkey: p2tr(0x11) };
+        let mut commit = vec![0x6a, 0x20];
+        commit.extend([9u8; 32]);
+        let txin = |op: String| TxIn { previous_output: parse_outpoint(&op).unwrap(), script_sig: ScriptBuf::new(), sequence: Sequence::ENABLE_RBF_NO_LOCKTIME, witness: Witness::new() };
+        let tx = BdkTransaction {
+            version: Version::TWO,
+            lock_time: LockTime::ZERO,
+            input: vec![txin(format!("{}:0", "00".repeat(32))), txin(format!("{}:1", "ab".repeat(32)))],
+            output: vec![
+                TxOut { value: Amount::ZERO, script_pubkey: ScriptBuf::from_bytes(commit) },
+                TxOut { value: Amount::from_sat(51000), script_pubkey: p2tr(0x11) },
+                TxOut { value: Amount::from_sat(330), script_pubkey: p2tr(0x11) },
+            ],
+        };
+        let all = [placeholder.clone(), prev.clone()];
+        let mut cache = SighashCache::new(&tx);
+        let hash = if sighash == TapSighashType::SinglePlusAnyoneCanPay {
+            cache.taproot_key_spend_signature_hash(1, &Prevouts::One(1, &prev), sighash).unwrap()
+        } else {
+            cache.taproot_key_spend_signature_hash(1, &Prevouts::All(&all), sighash).unwrap()
+        };
+        let sig = secp.sign_schnorr_no_aux_rand(&Message::from_digest(hash.to_byte_array()), &tweaked.to_keypair());
+        let mut s = sig.as_ref().to_vec();
+        s.push(sighash as u8);
+        let mut psbt = Psbt::from_unsigned_tx(tx).unwrap();
+        psbt.inputs[0].witness_utxo = Some(placeholder);
+        psbt.inputs[1].witness_utxo = Some(prev.clone());
+        psbt.inputs[1].final_script_witness = Some(Witness::from_slice(&[s]));
+        (psbt.to_string(), prev)
+    }
+
+    #[test]
+    fn presigned_template_and_buy() {
+        let (t, _) = template(TapSighashType::SinglePlusAnyoneCanPay);
+        let info = presigned_listing_info(&t).unwrap();
+        assert_eq!(info.payout_sats, 51000);
+        assert_eq!(info.seller_sats, 1000);
+        assert_eq!(info.template_txid.len(), 64);
+
+        // the buyer adds its coin and change, puts its seal address: the seller's signature still holds
+        let buyer = "5120".to_string() + &"22".repeat(32);
+        let seal = "5120".to_string() + &"33".repeat(32);
+        // two buyer coins: the first takes the placeholder's place, the second goes after the seller's input
+        let inputs = vec![
+            SwapInput { outpoint: format!("{}:0", "cd".repeat(32)), sats: 40000, script: buyer.clone(), tx: None },
+            SwapInput { outpoint: format!("{}:2", "ce".repeat(32)), sats: 20000, script: buyer.clone(), tx: None },
+        ];
+        let change = Some(SwapOutput { script: Some(buyer.clone()), sats: 60000 + 1000 - 51000 - 330 - 700 });
+        let p = presigned_buy_psbt(&t, inputs.clone(), seal.clone(), change).unwrap();
+        let psbt = Psbt::from_str(&p).unwrap();
+        assert_eq!(psbt.unsigned_tx.input.len(), 3);
+        assert_eq!(psbt.unsigned_tx.input[0].previous_output.to_string(), inputs[0].outpoint);
+        assert_eq!(psbt.unsigned_tx.input[1].previous_output.to_string(), format!("{}:1", "ab".repeat(32)));
+        assert_eq!(psbt.unsigned_tx.input[2].previous_output.to_string(), inputs[1].outpoint);
+        assert_eq!(psbt.inputs[2].witness_utxo.as_ref().unwrap().value.to_sat(), 20000);
+        assert_eq!(psbt.unsigned_tx.output.len(), 4);
+        assert!(psbt.unsigned_tx.output[0].script_pubkey.is_op_return(), "the commitment stays first");
+        assert!(psbt.inputs[1].final_script_witness.is_some(), "the seller's signature is kept");
+        let mut tx = psbt.unsigned_tx.clone();
+        tx.input[1].witness = psbt.inputs[1].final_script_witness.clone().unwrap();
+        tx.input[0].witness = Witness::from_slice(&[vec![1u8; 64]]);
+        tx.input[2].witness = Witness::from_slice(&[vec![1u8; 64]]);
+        let hex = bdk_wallet::bitcoin::consensus::encode::serialize_hex(&tx);
+        let txid = check_presigned_final(&t, &hex, &seal).unwrap();
+        // from the PSBT itself, once every input is finalized
+        let mut fin = psbt.clone();
+        assert!(psbt_extract_hex(&fin.to_string()).is_err(), "the buyer's inputs aren't signed yet");
+        fin.inputs[0].final_script_witness = Some(Witness::from_slice(&[vec![1u8; 64]]));
+        fin.inputs[2].final_script_witness = Some(Witness::from_slice(&[vec![1u8; 64]]));
+        assert_eq!(psbt_extract_hex(&fin.to_string()).unwrap(), hex);
+        assert_ne!(txid, info.template_txid);
+
+        // the seal must pay the buyer; the payout and the commitment can't change; a second OP_RETURN is refused
+        assert!(check_presigned_final(&t, &hex, &buyer).is_err());
+        let mut less = tx.clone();
+        less.output[1].value = Amount::from_sat(50000);
+        assert!(check_presigned_final(&t, &bdk_wallet::bitcoin::consensus::encode::serialize_hex(&less), &seal).is_err());
+        let mut other = tx.clone();
+        other.output[0].script_pubkey = ScriptBuf::new_op_return([1u8; 32]);
+        assert!(check_presigned_final(&t, &bdk_wallet::bitcoin::consensus::encode::serialize_hex(&other), &seal).is_err());
+        let mut two = tx.clone();
+        two.output.push(TxOut { value: Amount::ZERO, script_pubkey: ScriptBuf::new_op_return([2u8; 32]) });
+        assert!(check_presigned_final(&t, &bdk_wallet::bitcoin::consensus::encode::serialize_hex(&two), &seal).is_err());
+
+        // not enough bitcoin
+        let poor = vec![SwapInput { outpoint: format!("{}:0", "cd".repeat(32)), sats: 100, script: buyer.clone(), tx: None }];
+        assert!(presigned_buy_psbt(&t, poor, seal.clone(), None).is_err());
+        // the seller's own output can't be the buyer's coin
+        let own = vec![SwapInput { outpoint: format!("{}:1", "ab".repeat(32)), sats: 90000, script: buyer.clone(), tx: None }];
+        assert!(presigned_buy_psbt(&t, own, seal, None).is_err());
+    }
+
+    #[test]
+    fn presigned_refuses_other_sighashes_and_bad_signatures() {
+        // SIGHASH_ALL would be valid but useless (no one could add inputs): refused
+        let (t, _) = template(TapSighashType::All);
+        assert!(presigned_listing_info(&t).is_err());
+        // a signature for another payout
+        let (t, _) = template(TapSighashType::SinglePlusAnyoneCanPay);
+        let mut psbt = Psbt::from_str(&t).unwrap();
+        psbt.unsigned_tx.output[1].value = Amount::from_sat(99000);
+        assert!(presigned_listing_info(&psbt.to_string()).unwrap_err().to_string().contains("not valid"));
+        // unsigned
+        let mut psbt = Psbt::from_str(&t).unwrap();
+        psbt.inputs[1].final_script_witness = None;
+        assert!(presigned_listing_info(&psbt.to_string()).is_err());
+        // the old layout (payout first, a taproot output before the commitment) is refused
+        let mut psbt = Psbt::from_str(&t).unwrap();
+        psbt.unsigned_tx.output.swap(0, 1);
+        assert!(presigned_listing_info(&psbt.to_string()).is_err());
+        // not a consignment
+        assert!(complete_presigned_consignment(&[1, 2, 3], &"ab".repeat(32), "00").is_err());
+    }
+}
