+
+fn parse_outpoint(s: &str) -> Result<OutPoint, Error> {
+    OutPoint::from_str(s.trim()).map_err(|_| Error::Internal { details: format!("not an outpoint: {s}") })
+}
+fn script_from_hex(h: &str) -> Result<ScriptBuf, Error> {
+    ScriptBuf::from_hex(h.trim()).map_err(|_| Error::Internal { details: s!("bad output script hex") })
+}
+
+/// An unsigned swap PSBT: the inputs in order, an empty OP_RETURN at output 0 (where the RGB commitment goes),
+/// then `outputs` in order. Version 2, RBF signalled, no lock time.
+pub fn new_swap_psbt(inputs: Vec<SwapInput>, outputs: Vec<SwapOutput>) -> Result<String, Error> {
+    use bdk_wallet::bitcoin::{Amount, Sequence, TxIn, Witness, absolute::LockTime, consensus::deserialize, transaction::Version};
+    if inputs.len() < 2 || outputs.is_empty() {
+        return Err(Error::Internal { details: s!("a swap has at least two inputs and one output") });
+    }
+    let mut tx_in = vec![];
+    for i in &inputs {
+        tx_in.push(TxIn { previous_output: parse_outpoint(&i.outpoint)?, script_sig: ScriptBuf::new(), sequence: Sequence::ENABLE_RBF_NO_LOCKTIME, witness: Witness::new() });
+    }
+    let mut tx_out = vec![TxOut { value: Amount::ZERO, script_pubkey: ScriptBuf::new_op_return([]) }];
+    for o in &outputs {
+        let script = o.script.as_deref().ok_or(Error::Internal { details: s!("every output needs a script") })?;
+        tx_out.push(TxOut { value: Amount::from_sat(o.sats), script_pubkey: script_from_hex(script)? });
+    }
+    let tx = BdkTransaction { version: Version::TWO, lock_time: LockTime::ZERO, input: tx_in, output: tx_out };
+    let mut psbt = Psbt::from_unsigned_tx(tx).map_err(|e| Error::Internal { details: e.to_string() })?;
+    for (k, i) in inputs.iter().enumerate() {
+        psbt.inputs[k].witness_utxo = Some(TxOut { value: Amount::from_sat(i.sats), script_pubkey: script_from_hex(&i.script)? });
+        if let Some(h) = &i.tx {
+            let bytes = <Vec<u8> as bdk_wallet::bitcoin::hex::FromHex>::from_hex(h.trim()).map_err(|_| Error::Internal { details: s!("bad previous transaction hex") })?;
+            let prev: BdkTransaction = deserialize(&bytes).map_err(|_| Error::Internal { details: s!("bad previous transaction") })?;
+            let op = psbt.unsigned_tx.input[k].previous_output;
+            if prev.compute_txid() != op.txid {
+                return Err(Error::Internal { details: s!("previous transaction does not match the input") });
+            }
+            psbt.inputs[k].non_witness_utxo = Some(prev);
+        }
+    }
+    Ok(psbt.to_string())
+}
+
+/// The outpoints a PSBT spends, "txid:vout", in order.
+pub fn psbt_outpoints(psbt: &str) -> Result<Vec<String>, Error> {
+    let psbt = Psbt::from_str(psbt)?;
+    Ok(psbt.unsigned_tx.input.iter().map(|i| i.previous_output.to_string()).collect())
+}
+
+/// The txid of a PSBT's unsigned transaction (the witness id its consignment carries).
+pub fn psbt_txid(psbt: &str) -> Result<String, Error> {
+    let psbt = Psbt::from_str(psbt)?;
+    Ok(psbt.unsigned_tx.compute_txid().to_string())
+}
+
+/// Check a swap PSBT against what was agreed, before signing it: exactly these inputs in this order, output 0 an
+/// OP_RETURN, then exactly these outputs (a `None` script matches any script, the amount must still match), and
+/// a network fee of exactly `fee_sats` (input values from the PSBT; a wrong value makes every signature invalid).
+pub fn verify_swap_psbt(psbt: &str, inputs: Vec<String>, outputs: Vec<SwapOutput>, fee_sats: u64) -> Result<(), Error> {
+    let bad = |m: &str| Error::Internal { details: format!("swap check: {m}") };
+    let psbt = Psbt::from_str(psbt)?;
+    let tx = &psbt.unsigned_tx;
+    if tx.input.len() != inputs.len() {
+        return Err(bad("the number of inputs changed"));
+    }
+    for (k, want) in inputs.iter().enumerate() {
+        if tx.input[k].previous_output != parse_outpoint(want)? {
+            return Err(bad(&format!("input {k} is not the agreed one")));
+        }
+    }
+    if tx.output.len() != outputs.len() + 1 {
+        return Err(bad("the number of outputs changed"));
+    }
+    if !tx.output[0].script_pubkey.is_op_return() || tx.output[0].value.to_sat() != 0 {
+        return Err(bad("output 0 must be the RGB commitment"));
+    }
+    for (k, want) in outputs.iter().enumerate() {
+        let got = &tx.output[k + 1];
+        if got.value.to_sat() != want.sats {
+            return Err(bad(&format!("output {} pays {} sats, agreed {}", k + 1, got.value.to_sat(), want.sats)));
+        }
+        if let Some(h) = &want.script {
+            if got.script_pubkey != script_from_hex(h)? {
+                return Err(bad(&format!("output {} pays another address", k + 1)));
+            }
+        }
+    }
+    let mut ins = 0u64;
+    for (k, i) in psbt.inputs.iter().enumerate() {
+        let v = i.witness_utxo.as_ref().map(|o| o.value.to_sat()).ok_or(bad(&format!("input {k} has no amount")))?;
+        ins = ins.saturating_add(v);
+    }
+    let outs: u64 = tx.output.iter().map(|o| o.value.to_sat()).sum();
+    if ins < outs || ins - outs != fee_sats {
+        return Err(bad(&format!("the network fee is {} sats, agreed {fee_sats}", ins.saturating_sub(outs))));
+    }
+    Ok(())
+}
+
+/// The output script a witness invoice's seal must be paid to, hex.
+pub fn witness_seal_script(invoice: &str) -> Result<String, Error> {
+    let inv = RgbInvoice::from_str(invoice.trim()).map_err(|_| Error::InvalidInvoice { details: s!("not an RGB invoice") })?;
+    let rid = inv.beneficiary.to_string();
+    let script = crate::utils::script_buf_from_recipient_id(rid)?.ok_or(Error::InvalidRecipientData { details: s!("a swap needs a witness (wvout) invoice") })?;
+    Ok(script.to_hex_string())
+}
