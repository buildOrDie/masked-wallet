+// ---- legacy consignments (MASKED) ----
+// Wallets still on RGB 0.11.1 (rgb-lib 0.3.0-beta.5 and earlier, MASKED up to 2.28) send consignments in the V0
+// format, which a V1 decoder refuses. rgb-ops converts them (`legacy` feature); bundles that name their witness
+// transaction only by txid get it from the indexer.
+impl Wallet {
+    /// `bytes` unchanged if they aren't a V0 transfer consignment; otherwise the same consignment as V1.
+    pub(crate) async fn upgrade_legacy_consignment(&self, bytes: Vec<u8>) -> Result<Vec<u8>, Error> {
+        let Some(v0) = legacy_transfer_v0(&bytes)? else {
+            return Ok(bytes);
+        };
+        let txids: Vec<RgbTxid> = v0
+            .bundles
+            .iter()
+            .filter_map(|b| match &b.pub_witness {
+                rgbstd::containers::legacy::PubWitness::Txid(t) => Some(*t),
+                _ => None,
+            })
+            .collect();
+        let resolver = self.prefetch_witnesses(txids).await?;
+        convert_legacy_transfer(v0, Some(&resolver))
+    }
+}
+
+/// The V0 transfer in `bytes` ("RGB\0TFR" then version 0), or None for anything else.
+pub(crate) fn legacy_transfer_v0(
+    bytes: &[u8],
+) -> Result<Option<rgbstd::containers::legacy::TransferV0>, Error> {
+    const HEAD: &[u8] = b"RGB\0TFR";
+    if bytes.len() < HEAD.len() + 1 || &bytes[..HEAD.len()] != HEAD || bytes[HEAD.len()] != 0 {
+        return Ok(None);
+    }
+    let data = amplify::confinement::Confined::<Vec<u8>, 0, { usize::MAX }>::try_from(
+        bytes[HEAD.len()..].to_vec(),
+    )
+    .map_err(|e| Error::Internal { details: format!("legacy consignment too large: {e}") })?;
+    use strict_encoding::StrictDeserialize;
+    let v0 = rgbstd::containers::legacy::TransferV0::from_strict_serialized::<{ usize::MAX }>(data)
+        .map_err(|e| Error::Internal { details: format!("can't read the legacy consignment: {e}") })?;
+    Ok(Some(v0))
+}
+
+/// A V0 transfer as V1 consignment bytes (what `RgbTransfer::load` reads).
+pub(crate) fn convert_legacy_transfer(
+    v0: rgbstd::containers::legacy::TransferV0,
+    resolver: Option<&dyn ResolveWitness>,
+) -> Result<Vec<u8>, Error> {
+    let v1: RgbTransfer = v0
+        .into_v1(resolver)
+        .map_err(|e| Error::Internal { details: format!("can't convert the legacy consignment: {e}") })?;
+    let mut out = Vec::new();
+    v1.save(&mut out).map_err(|e| Error::Internal { details: e.to_string() })?;
+    Ok(out)
+}
