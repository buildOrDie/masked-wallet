+// ---- pre-signed listings (MASKED "Instant") ----
+// The seller signs its RGB output once, with SIGHASH_SINGLE|ANYONECANPAY: the signature covers that input and
+// output 0 (the seller's payout) only, so anyone can complete the transaction by adding their own bitcoin, and the
+// seller is paid its price whoever does. Because the buyer then controls every other output, including the
+// OP_RETURN, the output must carry exactly the listed amount of one asset and nothing else: whoever spends it can
+// take everything on it. Layout: RGB anchors to the first OP_RETURN or taproot output, so the OP_RETURN is output 0;
+// SIGHASH_SINGLE pairs input i with output i, so the seller's output is input 1 and its payout output 1. Input 0 is a
+// placeholder the buyer replaces with its own (ANYONECANPAY doesn't commit to the other inputs or to the index).
+// Outputs: 0 OP_RETURN, 1 payout, 2 the buyer's seal (330 sats), then the buyer's change.
+
+/// Output of the buyer's seal in a pre-signed listing.
+pub const PRESIGNED_SEAL_VOUT: u32 = 2;
+/// Input (and output) of the seller in a pre-signed listing.
+pub const PRESIGNED_SELLER_INDEX: usize = 1;
+/// Sats on the buyer's seal output: the dust limit of a taproot output.
+pub const PRESIGNED_SEAL_SATS: u64 = 330;
+
+/// A pre-signed listing: the template PSBT (input 0 signed and finalized), the consignment for its template
+/// transaction (the buyer validates it before paying), and the seller's output.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+#[cfg_attr(feature = "camel_case", serde(rename_all = "camelCase"))]
+pub struct PresignedSale {
+    /// base64 PSBT
+    pub psbt: String,
+    /// strict-encoded consignment for `template_txid`
+    pub consignment: Vec<u8>,
+    /// txid of the template transaction the consignment names (the real one differs: the buyer adds inputs)
+    pub template_txid: String,
+    /// "txid:vout"
+    pub seller_outpoint: String,
+    /// sats on the seller's output (returned to it in the payout)
+    pub seller_sats: u64,
+}
+
+fn parse_db_outpoint(s: &str) -> Result<Outpoint, Error> {
+    let (txid, vout) = s.trim().rsplit_once(':').ok_or(Error::Internal { details: format!("not an outpoint: {s}") })?;
+    let vout = vout.parse::<u32>().map_err(|_| Error::Internal { details: format!("not an outpoint: {s}") })?;
+    bdk_wallet::bitcoin::Txid::from_str(txid).map_err(|_| Error::Internal { details: format!("not an outpoint: {s}") })?;
+    Ok(Outpoint { txid: txid.to_string(), vout })
+}
+
+impl Wallet {
+    /// Outputs promised to pre-signed listings: sends, change and receives never use them. The list lives in
+    /// memory; MASKED sets it every time it opens the wallet.
+    pub fn set_reserved_outpoints(&mut self, outpoints: Vec<String>) -> Result<(), Error> {
+        let mut set = HashSet::new();
+        for o in outpoints {
+            set.insert(parse_db_outpoint(&o)?);
+        }
+        self.reserved_outpoints = set;
+        Ok(())
+    }
+
+    /// A pre-signed listing was bought (the caller checked on chain that `outpoint` is spent by a transaction this
+    /// wallet didn't broadcast): mark the output spent so its tokens leave the balance. Returns false when the
+    /// wallet doesn't know the output.
+    pub fn mark_outpoint_spent(&mut self, outpoint: String) -> Result<bool, Error> {
+        let op = parse_db_outpoint(&outpoint)?;
+        let Some(db_txo) = self.database.get_txo(&op)? else {
+            return Ok(false);
+        };
+        let mut db_txo: DbTxoActMod = db_txo.into();
+        db_txo.spent = ActiveValue::Set(true);
+        self.database.update_txo(db_txo)?;
+        self.reserved_outpoints.remove(&op);
+        Ok(true)
+    }
+
+    /// Pre-sign a listing of `outpoint`, which must hold exactly `amount` of `asset_id` and nothing else, for
+    /// `price_sats` paid to `payout_script` (hex). The payout also returns the output's own sats.
+    pub async fn presign_sale(
+        &mut self,
+        online: Online,
+        asset_id: String,
+        amount: u64,
+        outpoint: String,
+        payout_script: String,
+        price_sats: u64,
+        min_confirmations: u8,
+    ) -> Result<PresignedSale, Error> {
+        use bdk_wallet::bitcoin::{Amount, Sequence, TxIn, Witness, absolute::LockTime, transaction::Version};
+        use bdk_wallet::bitcoin::{psbt::PsbtSighashType, sighash::TapSighashType};
+        info!(self.logger, "Pre-signing a listing of {asset_id}...");
+        if amount == 0 {
+            return Err(Error::InvalidAmountZero);
+        }
+        if price_sats < 1000 {
+            return Err(Error::Internal { details: s!("the price must be at least 1,000 sats") });
+        }
+        let op = parse_db_outpoint(&outpoint)?;
+        let payout = ScriptBuf::from_hex(payout_script.trim())
+            .map_err(|_| Error::Internal { details: s!("bad payout script hex") })?;
+        if payout.is_op_return() || payout.is_empty() {
+            return Err(Error::Internal { details: s!("the payout must go to an address") });
+        }
+
+        let asset = self.database.check_asset_exists(asset_id.clone())?;
+        self.check_schema_support(&asset.schema)?;
+        if !matches!(asset.schema, AssetSchema::Nia | AssetSchema::Ifa) {
+            return Err(Error::InvalidAssignment);
+        }
+        let contract_id = ContractId::from_str(&asset_id).map_err(|_| Error::AssetNotFound { asset_id: asset_id.clone() })?;
+
+        let (_fee_rate, unspents, _input_unspents, mut runtime) = self._get_transfer_begin_data(online, 1)?;
+        let unspent = self
+            .input_unspents_any(&unspents)?
+            .into_iter()
+            .find(|u| u.utxo.outpoint() == op)
+            .ok_or(Error::Internal { details: s!("that output can't be listed: it isn't a settled RGB output of this wallet") })?;
+        // the database's view: one settled allocation of this asset, nothing pending
+        if unspent.rgb_allocations.is_empty()
+            || unspent.rgb_allocations.iter().any(|a| a.asset_id.as_deref() != Some(asset_id.as_str()) || !a.settled() || a.future())
+        {
+            return Err(Error::Internal { details: s!("that output also holds other assets or pending transfers: move the tokens to their own output first") });
+        }
+        // the RGB state's view: only this contract, exactly this amount
+        let bdk_op: BdkOutPoint = op.clone().into();
+        let contracts = runtime.contracts_assigning([bdk_op])?;
+        if contracts.len() != 1 || !contracts.contains(&contract_id) {
+            return Err(Error::Internal { details: s!("that output also holds other assets: move the tokens to their own output first") });
+        }
+        let mut held = 0u64;
+        for (_seal, states) in runtime.contract_assignments_for(contract_id, [bdk_op])? {
+            for (_opout, state) in states {
+                match state {
+                    AllocatedState::Amount(a) => held = held.saturating_add(a.as_u64()),
+                    _ => return Err(Error::Internal { details: s!("that output holds non-fungible state") }),
+                }
+            }
+        }
+        if held != amount {
+            return Err(Error::Internal { details: format!("that output holds {held}, not {amount}: move exactly the amount to sell to its own output first") });
+        }
+
+        let prev = self
+            .bdk_wallet
+            .get_utxo(bdk_op)
+            .ok_or(Error::Internal { details: s!("the wallet doesn't have that output's details: sync and try again") })?;
+        let seller_sats = prev.txout.value.to_sat();
+        let payout_sats = price_sats.checked_add(seller_sats).ok_or(Error::Internal { details: s!("price too high") })?;
+
+        // template: input 0 is a placeholder for the buyer's coin; the seal pays the payout script for now (the buyer
+        // puts its own address there)
+        let placeholder = bdk_wallet::bitcoin::OutPoint { txid: bdk_wallet::bitcoin::Txid::from_str(&"00".repeat(31).chars().chain("01".chars()).collect::<String>()).unwrap(), vout: 0 };
+        let tx = BdkTransaction {
+            version: Version::TWO,
+            lock_time: LockTime::ZERO,
+            input: vec![
+                TxIn { previous_output: placeholder, script_sig: ScriptBuf::new(), sequence: Sequence::ENABLE_RBF_NO_LOCKTIME, witness: Witness::new() },
+                TxIn { previous_output: bdk_op, script_sig: ScriptBuf::new(), sequence: Sequence::ENABLE_RBF_NO_LOCKTIME, witness: Witness::new() },
+            ],
+            output: vec![
+                TxOut { value: Amount::ZERO, script_pubkey: ScriptBuf::new_op_return([]) },
+                TxOut { value: Amount::from_sat(payout_sats), script_pubkey: payout.clone() },
+                TxOut { value: Amount::from_sat(PRESIGNED_SEAL_SATS), script_pubkey: payout.clone() },
+            ],
+        };
+        let mut psbt = Psbt::from_unsigned_tx(tx).map_err(|e| Error::Internal { details: e.to_string() })?;
+        psbt.inputs[0].witness_utxo = Some(TxOut { value: Amount::ZERO, script_pubkey: payout.clone() });
+        psbt.inputs[PRESIGNED_SELLER_INDEX].witness_utxo = Some(prev.txout.clone());
+        let recipient_id = crate::utils::recipient_id_from_script_buf(payout.clone(), self.bitcoin_network());
+        let recipient = LocalRecipient {
+            recipient_id,
+            local_recipient_data: LocalRecipientData::Witness(LocalWitnessData { amount_sat: PRESIGNED_SEAL_SATS, blinding: None, vout: PRESIGNED_SEAL_VOUT }),
+            assignment: Assignment::Fungible(amount),
+            transport_endpoints: vec![],
+            public_key: vec![],
+            encryption: Encryption::Unsupported,
+            invoice_expiration: None,
+        };
+        let operation_sk = crate::encryption::gen_ed25519();
+        let mut psbt = self
+            ._color_swap_psbt(psbt, &asset_id, amount, recipient, unspents, &mut runtime, min_confirmations, operation_sk.to_bytes().to_vec(), None)
+            .await?;
+        let template_txid = psbt.unsigned_tx.compute_txid().to_string();
+        let artifacts = self.transfer_artifacts.remove(&template_txid);
+        // this transaction never goes out as it is: keep the tokens spendable here (cancelling moves them)
+        runtime.upsert_witness(RgbTxid::from_str(&template_txid).unwrap(), WitnessOrd::Archived)?;
+        let consignment = artifacts
+            .and_then(|a| a.consignment_bytes.get(&asset_id).cloned())
+            .ok_or(Error::Internal { details: s!("the listing's consignment was not made") })?;
+
+        // only the colouring may have changed the outputs: same layout, commitment in output 0
+        let outs = &psbt.unsigned_tx.output;
+        if outs.len() != 3 || !outs[0].script_pubkey.is_op_return() || outs[1].script_pubkey != payout || outs[1].value.to_sat() != payout_sats || outs[2].value.to_sat() != PRESIGNED_SEAL_SATS || psbt.unsigned_tx.input.len() != 2 {
+            return Err(Error::Internal { details: s!("the listing transaction changed while colouring") });
+        }
+
+        psbt.inputs[PRESIGNED_SELLER_INDEX].sighash_type = Some(PsbtSighashType::from(TapSighashType::SinglePlusAnyoneCanPay));
+        let sign_options = SignOptions { allow_all_sighashes: true, ..Default::default() };
+        self._sign_psbt(&mut psbt, Some(sign_options))?;
+        if psbt.inputs[PRESIGNED_SELLER_INDEX].final_script_witness.is_none() {
+            return Err(Error::Internal { details: s!("the wallet could not sign its output") });
+        }
+        self.reserved_outpoints.insert(op.clone());
+        info!(self.logger, "Pre-signed listing ready");
+        Ok(PresignedSale { psbt: psbt.to_string(), consignment, template_txid, seller_outpoint: op.to_string(), seller_sats })
+    }
+
+    /// Drop a colouring that will never be broadcast (its delivery failed): forget its artifacts and archive its
+    /// transaction in the RGB state, so the tokens it would have spent stay spendable.
+    pub fn abandon_coloring(&mut self, txid: String) -> Result<(), Error> {
+        self.transfer_artifacts.remove(&txid);
+        let id = RgbTxid::from_str(&txid).map_err(|_| Error::InvalidTxid)?;
+        self.rgb_runtime()?.upsert_witness(id, WitnessOrd::Archived)?;
+        Ok(())
+    }
+}
+
+impl Wallet {
+    /// MASKED: the witness invoices of pre-signed purchases this wallet made (see `ReceiveMatcher::Witness`).
+    /// The list lives in memory; MASKED sets it every time it opens the wallet.
+    pub fn set_presigned_receives(&mut self, recipient_ids: Vec<String>) {
+        self.presigned_receives = recipient_ids.into_iter().collect();
+    }
+}
