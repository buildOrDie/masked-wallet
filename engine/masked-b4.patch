diff --git a/src/wallet/legacy_migration.rs b/src/wallet/legacy_migration.rs
new file mode 100644
index 0000000..0bc354a
--- /dev/null
+++ b/src/wallet/legacy_migration.rs
@@ -0,0 +1,460 @@
+//! MASKED: upgrade of a wallet saved by rgb-lib-wasm 1.0.0-beta.3 (RGB 0.11.1) to this version.
+//!
+//! The older version saved its IndexedDB snapshot under the wallet directory (this one adds the
+//! network to the key), with the RGB stock as three strict-encoded V0 blobs (stash, state, index)
+//! and a database without the protocol 1.0 columns. Opening the wallet with no snapshot under the new
+//! key looks for one under the old key and converts it:
+//!
+//! - the RGB stock goes into the new store like rgb-lib's own legacy migration does for its files
+//!   (`migrate_rgb_fs_to_db`): geneses, bundles, witnesses, seals, witness orders, invalid operations,
+//!   global state, allocations and the indexes; the schema definitions are imported again;
+//! - the database gets its new columns with their defaults. Transfers still waiting for the other side
+//!   used the 0.2 transfer protocol, which this version can't finish: they become Failed, which frees
+//!   what they held. Settled and confirming transfers stay as they are;
+//! - the BTC wallet state is kept when it still reads, otherwise the next full scan rebuilds it;
+//! - received consignments stay as they were (they are converted to V1 when next read).
+//!
+//! The old snapshot is never changed or removed: it stays under its key as a backup. A legacy witness
+//! that names its transaction only by txid needs that transaction: `migrate` is given the ones the
+//! caller fetched (see `legacy_unresolved_witnesses`); without them the conversion stops with an error
+//! rather than open a wallet with part of its history missing.
+
+use std::collections::{BTreeSet, HashMap};
+
+use base64::{Engine as _, engine::general_purpose};
+use rgbstd::{
+    ChainNet, ContractId, OpId, Operation as _,
+    contract::{KnownState, OpWitness, OutputAssignment},
+    persistence::{
+        AllocKind, AllocSeal, AllocationWrite, GlobalStateWrite, MemIndexV0, MemStashV0,
+        MemStateV0, RgbStore, encode,
+    },
+    rgbcore::{
+        bitcoin::{OutPoint, Transaction, Txid},
+        commit_verify::Conceal,
+        validation::{ResolveWitness, WitnessResolverError, WitnessStatus},
+        vm::WitnessOrd,
+    },
+};
+use serde_json::{Value, json};
+use strict_encoding::{StrictDeserialize, StrictEncode};
+
+use crate::database::enums::AssetSchema;
+use crate::database::rgb_store::MemRgbStore;
+use crate::utils::MemStock;
+use crate::wallet::idb_store::{WalletSnapshot, serialize_stock};
+
+/// Transactions fetched by the caller, for legacy witnesses that name only a txid.
+struct MapResolver<'a>(&'a HashMap<Txid, Transaction>);
+
+impl ResolveWitness for MapResolver<'_> {
+    fn resolve_witness(&self, witness_id: Txid) -> Result<WitnessStatus, WitnessResolverError> {
+        Ok(match self.0.get(&witness_id) {
+            Some(tx) => WitnessStatus::Resolved(tx.clone(), WitnessOrd::Tentative),
+            None => WitnessStatus::Unresolved,
+        })
+    }
+    fn check_chain_net(&self, _chain_net: ChainNet) -> Result<(), WitnessResolverError> {
+        Ok(())
+    }
+}
+
+fn b64(json: &Value, field: &str) -> Result<Vec<u8>, String> {
+    let s = json
+        .get(field)
+        .and_then(|v| v.as_str())
+        .ok_or_else(|| format!("the old wallet has no {field}"))?;
+    general_purpose::STANDARD.decode(s).map_err(|e| format!("{field}: {e}"))
+}
+
+fn load_stash(json: &Value) -> Result<MemStashV0, String> {
+    let bytes = b64(json, "stock_stash_b64")?;
+    MemStashV0::from_strict_serialized::<{ u32::MAX as usize }>(
+        amplify::confinement::Confined::try_from(bytes).map_err(|e| e.to_string())?,
+    )
+    .map_err(|e| format!("old RGB stash: {e}"))
+}
+
+fn load_state(json: &Value) -> Result<MemStateV0, String> {
+    let bytes = b64(json, "stock_state_b64")?;
+    MemStateV0::from_strict_serialized::<{ u32::MAX as usize }>(
+        amplify::confinement::Confined::try_from(bytes).map_err(|e| e.to_string())?,
+    )
+    .map_err(|e| format!("old RGB state: {e}"))
+}
+
+fn load_index(json: &Value) -> Result<MemIndexV0, String> {
+    let bytes = b64(json, "stock_index_b64")?;
+    MemIndexV0::from_strict_serialized::<{ u32::MAX as usize }>(
+        amplify::confinement::Confined::try_from(bytes).map_err(|e| e.to_string())?,
+    )
+    .map_err(|e| format!("old RGB index: {e}"))
+}
+
+/// Whether `json` is a snapshot of the older version (it keeps the RGB stock as three V0 blobs).
+pub(crate) fn is_legacy_snapshot(json: &Value) -> bool {
+    json.get("stock_stash_b64").is_some() && json.get("rgb_store").is_none()
+}
+
+/// The txids of the old stash's witnesses that hold only a txid: `migrate` needs their transactions.
+pub(crate) fn legacy_unresolved_witnesses(json: &Value) -> Result<Vec<Txid>, String> {
+    if json.get("stock_stash_b64").and_then(|v| v.as_str()).is_none() {
+        return Ok(vec![]);
+    }
+    let stash = load_stash(json)?;
+    Ok(stash
+        .witnesses()
+        .iter()
+        .filter_map(|(txid, w)| match &w.public {
+            rgbstd::containers::legacy::PubWitness::Txid(_) => Some(*txid),
+            _ => None,
+        })
+        .collect())
+}
+
+fn put_assignment<State: StrictEncode + KnownState>(
+    store: &mut MemRgbStore,
+    contract_id: ContractId,
+    kind: AllocKind,
+    oa: &OutputAssignment<State>,
+) -> Result<(), String> {
+    let value = encode(&oa.state).map_err(|e| e.to_string())?;
+    // the legacy state holds the seal resolved, while it is now stored as defined: one naming the witness
+    // of its own assignment was defined on the witness transaction
+    let seal = match oa.witness {
+        Some(witness) if witness == oa.seal.txid => AllocSeal::witness_vout(oa.seal.vout),
+        _ => AllocSeal::explicit(oa.seal),
+    };
+    store
+        .put_allocation(AllocationWrite {
+            contract_id,
+            kind,
+            opout: oa.opout,
+            seal,
+            bundle_id: oa.bundle_id,
+            value: &value,
+        })
+        .unwrap_or_else(|e| match e {});
+    Ok(())
+}
+
+/// The RGB stock of the old snapshot as the new store, schema definitions included.
+fn convert_stock(
+    json: &Value,
+    supported: &[AssetSchema],
+    txs: &HashMap<Txid, Transaction>,
+) -> Result<String, String> {
+    let stash = load_stash(json)?;
+    let state = load_state(json)?;
+    let index = load_index(json)?;
+    let resolver = MapResolver(txs);
+    let mut store = MemRgbStore::default();
+
+    for genesis in stash.geneses().values() {
+        store.put_genesis(genesis).unwrap_or_else(|e| match e {});
+    }
+    for bundle in stash.bundles().values() {
+        store.put_bundle(bundle).unwrap_or_else(|e| match e {});
+    }
+    for (txid, witness) in stash.witnesses().iter() {
+        let witness = witness
+            .clone()
+            .into_v1(Some(&resolver))
+            .map_err(|e| format!("old RGB witness {txid}: {e}"))?;
+        store.put_witness(&witness).unwrap_or_else(|e| match e {});
+    }
+    for graph_seal in stash.secret_seals().iter() {
+        store.put_secret_seal(graph_seal, graph_seal.conceal()).unwrap_or_else(|e| match e {});
+    }
+    for (txid, ord) in state.witnesses().iter() {
+        store.put_witness_ord(*txid, *ord).unwrap_or_else(|e| match e {});
+    }
+    for opid in state.invalid_ops().iter() {
+        store.set_op_validity(*opid, false).unwrap_or_else(|e| match e {});
+    }
+    for (contract_id, mcs) in state.contracts().iter() {
+        for (ty, global) in mcs.global().iter() {
+            for (out, data) in global.known().iter() {
+                let (bundle_id, transition_type) = match out.op_witness {
+                    OpWitness::Genesis => (None, None),
+                    OpWitness::Transition(_, transition_type) => {
+                        let bundle_id = index.op_bundle_index().get(&out.opid).copied().ok_or_else(|| {
+                            format!("the old RGB index has no bundle for operation {} of {contract_id}", out.opid)
+                        })?;
+                        (Some(bundle_id), Some(transition_type))
+                    }
+                };
+                store
+                    .put_global(GlobalStateWrite {
+                        contract_id: *contract_id,
+                        type_id: *ty,
+                        opid: out.opid,
+                        index: out.index,
+                        nonce: out.nonce,
+                        bundle_id,
+                        transition_type,
+                        value: data,
+                    })
+                    .unwrap_or_else(|e| match e {});
+            }
+        }
+        for oa in mcs.rights().iter() {
+            put_assignment(&mut store, *contract_id, AllocKind::Declarative, oa)?;
+        }
+        for oa in mcs.fungibles().iter() {
+            put_assignment(&mut store, *contract_id, AllocKind::Fungible, oa)?;
+        }
+        for oa in mcs.data().iter() {
+            put_assignment(&mut store, *contract_id, AllocKind::Structured, oa)?;
+        }
+    }
+    for (contract_id, ci) in index.contract_index().iter() {
+        for (output_seal, opouts) in ci.outpoint_opouts().iter() {
+            let outpoint = OutPoint::new(output_seal.txid, output_seal.vout.to_u32());
+            for opout in opouts.iter() {
+                store.put_outpoint_opout(*contract_id, outpoint, *opout).unwrap_or_else(|e| match e {});
+            }
+        }
+    }
+    let genesis_contracts: HashMap<OpId, ContractId> = stash
+        .geneses()
+        .iter()
+        .map(|(contract_id, genesis)| (genesis.id(), *contract_id))
+        .collect();
+    for (secret_seal, opouts) in index.terminal_index().iter() {
+        for opout in opouts.iter() {
+            let contract_id = index
+                .op_bundle_index()
+                .get(&opout.op)
+                .and_then(|bundle_id| index.bundle_contract_index().get(bundle_id))
+                .or_else(|| genesis_contracts.get(&opout.op))
+                .ok_or_else(|| format!("the old RGB index has no contract for operation {}", opout.op))?;
+            store.put_secret_opout(*contract_id, *secret_seal, *opout).unwrap_or_else(|e| match e {});
+        }
+    }
+    for (opid, bundle_id) in index.op_bundle_index().iter() {
+        store.put_op_bundle(*opid, *bundle_id).unwrap_or_else(|e| match e {});
+    }
+    for (bundle_id, bundle) in stash.bundles().iter() {
+        for kt in &bundle.known_transitions {
+            for input in &kt.transition.inputs {
+                store.put_op_input(input, kt.opid, *bundle_id).unwrap_or_else(|e| match e {});
+            }
+        }
+    }
+    for (bundle_id, contract_id) in index.bundle_contract_index().iter() {
+        store.put_bundle_contract(*bundle_id, *contract_id).unwrap_or_else(|e| match e {});
+    }
+    for (bundle_id, txids) in index.bundle_witness_index().iter() {
+        for txid in txids.iter() {
+            store.put_bundle_witness(*bundle_id, *txid).unwrap_or_else(|e| match e {});
+        }
+    }
+
+    let mut stock = MemStock::with(store);
+    for schema in supported {
+        stock
+            .import_schema_definition(schema.schema_definition())
+            .map_err(|e| format!("schema {schema:?}: {e}"))?;
+    }
+    serialize_stock(&stock).ok_or_else(|| "could not save the converted RGB store".to_string())
+}
+
+/// The old database with the columns this version added, at their defaults. Transfers waiting for the
+/// other side (0.2 protocol) or never sent are failed.
+fn convert_db(db: &Value) -> Result<Value, String> {
+    let mut db = db.clone();
+    let obj = db.as_object_mut().ok_or("the old wallet database is not an object")?;
+    let rows = |obj: &mut serde_json::Map<String, Value>, table: &str, f: &mut dyn FnMut(&mut serde_json::Map<String, Value>)| {
+        if let Some(Value::Array(list)) = obj.get_mut(table) {
+            for row in list.iter_mut() {
+                if let Some(r) = row.as_object_mut() {
+                    f(r);
+                }
+            }
+        }
+    };
+    let mut failed: BTreeSet<i64> = BTreeSet::new();
+    rows(obj, "batch_transfers", &mut |r| {
+        let pending = matches!(r.get("status").and_then(|s| s.as_str()), Some("WaitingCounterparty" | "Initiated"));
+        if pending {
+            if let Some(i) = r.get("idx").and_then(|v| v.as_i64()) {
+                failed.insert(i);
+            }
+            r.insert("status".to_string(), json!("Failed"));
+        }
+    });
+    rows(obj, "transfers", &mut |r| {
+        r.entry("recipient_encryption").or_insert(json!("Unsupported"));
+    });
+    rows(obj, "transfer_transport_endpoints", &mut |r| {
+        r.entry("kind").or_insert(json!("RecipientProxy"));
+    });
+    rows(obj, "wallet_transactions", &mut |r| {
+        r.entry("status").or_insert(json!("WaitingConfirmations"));
+        r.entry("inputs").or_insert(json!([]));
+        r.entry("sent").or_insert(json!(0));
+        r.entry("received").or_insert(json!(0));
+        r.entry("fee").or_insert(json!(0));
+    });
+    let _ = failed;
+    Ok(db)
+}
+
+/// The old snapshot (JSON) as a snapshot of this version, written by `writer`.
+pub(crate) fn convert_legacy_snapshot(
+    json: &Value,
+    supported: &[AssetSchema],
+    txs: &HashMap<Txid, Transaction>,
+    writer: u64,
+) -> Result<WalletSnapshot, String> {
+    let rgb_store = convert_stock(json, supported, txs)?;
+    let db = serde_json::from_value(convert_db(json.get("db").ok_or("the old wallet has no database")?)?)
+        .map_err(|e| format!("old wallet database: {e}"))?;
+    // the BTC side: kept when it still reads, otherwise rebuilt by the next full scan
+    let bdk_changeset = json
+        .get("bdk_changeset")
+        .cloned()
+        .and_then(|v| serde_json::from_value(v).ok());
+    let received_consignments = json
+        .get("received_consignments")
+        .cloned()
+        .and_then(|v| serde_json::from_value(v).ok())
+        .unwrap_or_default();
+    let reuse_address_index = json
+        .get("reuse_address_index")
+        .cloned()
+        .and_then(|v| serde_json::from_value(v).ok())
+        .unwrap_or_default();
+    Ok(WalletSnapshot {
+        writer,
+        sequence: 1,
+        db,
+        bdk_changeset,
+        transfer_artifacts: HashMap::new(),
+        received_consignments,
+        received_consignment_meta: HashMap::new(),
+        received_signed_txs: HashMap::new(),
+        received_mints: HashMap::new(),
+        rgb_store,
+        reuse_address_index,
+    })
+}
+
+/// The IndexedDB key the older version saved this wallet under: its directory, without the network.
+pub(crate) fn legacy_key(wallet_dir: &std::path::Path) -> String {
+    wallet_dir.to_string_lossy().to_string()
+}
+
+/// Read the wallet the older version saved for `wallet_dir`, if any: `Some(json)` only for a legacy one.
+pub(crate) async fn load_legacy(wallet_dir: &std::path::Path) -> Result<Option<Value>, String> {
+    let Some(raw) = crate::wallet::idb_store::load_raw(&legacy_key(wallet_dir)).await? else {
+        return Ok(None);
+    };
+    let json: Value = serde_json::from_str(&raw).map_err(|e| format!("old wallet snapshot: {e}"))?;
+    Ok(is_legacy_snapshot(&json).then_some(json))
+}
+
+/// Convert the legacy wallet in `json` and save it under `new_key` (the old one stays where it is).
+pub(crate) async fn migrate_and_save(
+    json: &Value,
+    supported: &[AssetSchema],
+    txs: &HashMap<Txid, Transaction>,
+    writer: u64,
+    new_key: &str,
+) -> Result<WalletSnapshot, String> {
+    let snapshot = convert_legacy_snapshot(json, supported, txs, writer)?;
+    crate::wallet::idb_store::save_snapshot(new_key, &snapshot, None).await?;
+    Ok(snapshot)
+}
+
+/// The transactions of `txids` from an Esplora server (`{url}/tx/{txid}/hex`).
+pub(crate) async fn fetch_txs(indexer_url: &str, txids: &[Txid]) -> Result<HashMap<Txid, Transaction>, String> {
+    use gloo_net::http::Request;
+    let base = indexer_url.trim_end_matches('/');
+    let mut out = HashMap::new();
+    for txid in txids {
+        let resp = Request::get(&format!("{base}/tx/{txid}/hex"))
+            .send()
+            .await
+            .map_err(|e| format!("block server: {e}"))?;
+        if !resp.ok() {
+            return Err(format!("block server has no transaction {txid} ({})", resp.status()));
+        }
+        let hex = resp.text().await.map_err(|e| e.to_string())?;
+        let bytes = <Vec<u8> as rgbstd::rgbcore::bitcoin::hex::FromHex>::from_hex(hex.trim())
+            .map_err(|e| format!("transaction {txid}: {e}"))?;
+        let tx: Transaction = rgbstd::rgbcore::bitcoin::consensus::deserialize(&bytes)
+            .map_err(|e| format!("transaction {txid}: {e}"))?;
+        out.insert(*txid, tx);
+    }
+    Ok(out)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::wallet::idb_store::deserialize_stock;
+    use rgbstd::persistence::Stock;
+    use std::str::FromStr;
+
+    /// A snapshot written by rgb-lib-wasm 1.0.0-beta.3's own code (MASKED's engine up to 2.28): a MASKED NIA
+    /// issued to `aa…aa:1`, a settled issuance and an open 0.2 receive invoice.
+    const LEGACY: &str = include_str!("legacy_snapshot_b3.json");
+    const LEGACY_CONTRACT: &str = include_str!("legacy_snapshot_b3.json.contract");
+
+    #[test]
+    fn legacy_snapshot_converts() {
+        let json: Value = serde_json::from_str(LEGACY).unwrap();
+        assert!(is_legacy_snapshot(&json));
+        assert!(legacy_unresolved_witnesses(&json).unwrap().is_empty());
+        let snap = convert_legacy_snapshot(&json, &[AssetSchema::Nia, AssetSchema::Ifa], &HashMap::new(), 42).unwrap();
+        assert_eq!((snap.writer, snap.sequence), (42, 1));
+
+        // the tokens: the contract and its 21M on aa…aa:1, and the schemas this version needs
+        let stock: MemStock = deserialize_stock(&snap.rgb_store).unwrap();
+        let cid = ContractId::from_str(LEGACY_CONTRACT.trim()).unwrap();
+        assert!(stock.contracts().any(|c| c.unwrap().id == cid), "the contract came over");
+        let op = OutPoint::new(Txid::from_str(&"aa".repeat(32)).unwrap(), 1);
+        let mut held = 0u64;
+        for (_seal, states) in stock.contract_assignments_for(cid, [op]).unwrap() {
+            for (_opout, state) in states {
+                if let rgbstd::contract::AllocatedState::Amount(a) = state {
+                    held += a.as_u64();
+                }
+            }
+        }
+        assert_eq!(held, 21_000_000, "the balance came over");
+        assert!(stock.schemata().count() >= 2, "NIA and IFA schemas imported");
+
+        // the database: new columns at their defaults, the open 0.2 invoice failed, the rest untouched
+        let db = serde_json::to_value(&snap.db).unwrap();
+        let bt = db["batch_transfers"].as_array().unwrap();
+        assert_eq!(bt[0]["status"], "Settled");
+        assert_eq!(bt[1]["status"], "Failed");
+        assert_eq!(db["transfers"][1]["recipient_encryption"], "Unsupported");
+        assert_eq!(db["transfer_transport_endpoints"][0]["kind"], "RecipientProxy");
+        assert_eq!(db["wallet_transactions"][0]["status"], "WaitingConfirmations");
+        assert_eq!(db["assets"][0]["ticker"], "MASKED");
+        assert_eq!(snap.received_consignments.get("rid"), Some(&vec![1, 2, 3]));
+        assert!(snap.bdk_changeset.is_none());
+
+        // and it reads back as a snapshot of this version
+        let back: WalletSnapshot = serde_json::from_str(&serde_json::to_string(&snap).unwrap()).unwrap();
+        assert_eq!(back.sequence, 1);
+        let _ = Stock::<MemRgbStore>::default();
+    }
+
+    #[test]
+    fn current_snapshot_is_not_legacy() {
+        assert!(!is_legacy_snapshot(&json!({ "rgb_store": "", "db": {} })));
+        assert!(legacy_unresolved_witnesses(&json!({ "rgb_store": "" })).unwrap().is_empty());
+    }
+
+    #[test]
+    fn a_broken_legacy_stash_stops_the_conversion() {
+        let mut json: Value = serde_json::from_str(LEGACY).unwrap();
+        json["stock_stash_b64"] = json!("AAAA");
+        assert!(convert_legacy_snapshot(&json, &[AssetSchema::Nia], &HashMap::new(), 1).is_err());
+    }
+}
